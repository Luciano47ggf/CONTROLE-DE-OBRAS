-- Fixtures compartilhadas. Incluídas com \ir dentro da transação de cada teste
-- (extensão .psql para o runner não executá-las como teste).
-- Roda como superusuário; tudo é desfeito no ROLLBACK do teste.

create schema tests;
grant usage on schema tests to authenticated, anon;

-- Simula o login: define as claims do JWT na transação
create function tests.login(p_email text) returns void language sql security definer set search_path = public as $$
  select set_config('request.jwt.claims',
    json_build_object('sub', (select id from auth.users where email = p_email), 'role', 'authenticated')::text, true);
$$;
create function tests.logout() returns void language sql as $$
  select set_config('request.jwt.claims', '', true);
$$;
create function tests.art(p_code text) returns uuid language sql stable as $$ select id from public.artworks where code = p_code $$;
create function tests.space(p_name text) returns uuid language sql stable as $$ select id from public.client_spaces where name = p_name $$;
create function tests.environment(p_name text) returns uuid language sql stable as $$ select id from public.client_environments where name = p_name $$;
grant execute on all functions in schema tests to authenticated, anon;

-- Usuários
insert into auth.users (id, email) values
  ('a0000000-0000-0000-0000-000000000001', 'admin@teste.com'),
  ('a0000000-0000-0000-0000-000000000002', 'operador@teste.com'),
  ('a0000000-0000-0000-0000-000000000003', 'leitor@teste.com');
update profiles set role = 'admin'    where email = 'admin@teste.com';
update profiles set role = 'operador' where email = 'operador@teste.com';
update profiles set role = 'leitura'  where email = 'leitor@teste.com';
-- garante um único admin entre os perfis do teste
update profiles set role = 'operador' where role = 'admin' and email <> 'admin@teste.com';

-- Configuração conhecida
update app_settings set edge_margin_cm = 20, default_swap_days = 90, swap_warning_days = 15,
                        history_window_days = 730, idle_max_days = 180;

insert into categories (name) values ('T-Paisagem'), ('T-Abstrato');
insert into space_types (name) values ('T-Recepção');
insert into space_type_categories
  select t.id, c.id from space_types t, categories c where t.name = 'T-Recepção' and c.name = 'T-Paisagem';

insert into artists (name) values ('T-Artista');
insert into clients (name) values ('T-Hotel'), ('T-Empresa');

-- Um ambiente por cliente (nomes distintos para tests.environment() não ser ambíguo)
insert into client_environments (client_id, name)
select c.id, v.env from (values ('T-Hotel', 'T-Ambiente Hotel'), ('T-Empresa', 'T-Ambiente Empresa')) v(client, env)
  join clients c on c.name = v.client;

-- Recepção 400×250 → área útil 360×210; Corredor 260×200 → 220×160; Sala 300×200 → 260×160
insert into client_spaces (client_id, environment_id, name, space_type_id, width_cm, height_cm)
select c.id, e.id, v.name, t.id, v.w, v.h
  from (values ('T-Hotel', 'T-Ambiente Hotel', 'T-Recepção', 'T-Recepção', 400, 250),
               ('T-Hotel', 'T-Ambiente Hotel', 'T-Corredor', null, 260, 200),
               ('T-Empresa', 'T-Ambiente Empresa', 'T-Sala', null, 300, 200)) v(client, env, name, type, w, h)
  join clients c on c.name = v.client
  join client_environments e on e.client_id = c.id and e.name = v.env
  left join space_types t on t.name = v.type;

insert into artworks (code, title, artist_id, category_id, width_cm, height_cm, status)
select v.code, v.code, a.id, c.id, v.w, v.h, v.st::artwork_status
  from (values
    ('T-1', 'T-Paisagem', 380, 220, 'disponivel'),     -- cabe na parede, não na área útil
    ('T-2', 'T-Paisagem', 300, 180, 'disponivel'),
    ('T-3', 'T-Abstrato', 200, 150, 'disponivel'),
    ('T-4', 'T-Abstrato', 340, 200, 'disponivel'),
    ('T-5', 'T-Paisagem', 100,  80, 'em_manutencao'),
    ('T-6', 'T-Abstrato', 500, 300, 'disponivel'),     -- não cabe em nada
    ('T-7', 'T-Abstrato', 120,  90, 'disponivel')
  ) v(code, cat, w, h, st)
  join artists a on a.name = 'T-Artista'
  join categories c on c.name = v.cat;

-- Tempo parado no estoque determinístico
update artworks set status_changed_at = now() - interval '180 days' where code = 'T-2';
update artworks set status_changed_at = now()                       where code = 'T-3';
update artworks set status_changed_at = now() - interval '90 days'  where code = 'T-4';
