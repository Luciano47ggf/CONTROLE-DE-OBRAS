NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Somente no servidor (NUNCA com prefixo NEXT_PUBLIC_). Necessária para criar
# usuários, bloquear login e redefinir senhas na tela Usuários.
SUPABASE_SERVICE_ROLE_KEY=

# Fuso usado para "hoje" nas datas de instalação e retirada
APP_TIMEZONE=America/Cuiaba

# Para gerar tipos: projeto remoto (db:types) ou banco local (db:types:local)
SUPABASE_PROJECT_ID=
DATABASE_URL=
